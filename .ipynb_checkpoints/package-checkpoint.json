{
  "name": "smart-touch-pos",
  "private": true,
  "version": "1.0.10",
  "description": "البصمة الذكية - نظام إدارة نقاط البيع المتطور",
  "productName": "البصمة الذكية",
  "main": "electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/EbrahimAgaber/smart-touch-pos.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "clean": "rimraf dist dist-electron node_modules/.vite",
    "kill": "taskkill /F /IM electron.exe /T 2>nul & npx kill-port 5173 & exit 0",
    "electron:start": "cross-env NODE_ENV=development electron .",
    "electron:wait": "node wait-vite.cjs && npm run electron:start",
    "start": "npm run kill && concurrently -k --raw \"npm run dev\" \"npm run electron:wait\"",
    "clean:start": "npm run kill && npm run clean && concurrently -k --raw \"npm run dev\" \"npm run electron:wait\"",
    "reset": "npm run kill && rimraf node_modules/.vite dist dist-electron && npm run dev",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite build && cross-env NODE_ENV=production electron .",
    "dist": "npm run clean && npm run build && electron-builder"
  },
  "build": {
    "appId": "com.albasma.smarttouch",
    "productName": "البصمة الذكية",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "public/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "Setup.${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "البصمة الذكية",
      "createDesktopShortcut": "always"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "EbrahimAgaber",
        "repo": "smart-touch-pos"
      }
    ]
  },
  "author": "AL-Basma (ea.gaber10@gmail.com)",
  "dependencies": {
    "axios": "^1.15.2",
    "better-sqlite3": "^9.6.0",
    "bwip-js": "^4.11.1",
    "cors": "^2.8.6",
    "electron-updater": "^6.8.3",
    "express": "^5.2.1",
    "fuse.js": "^7.3.0",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.383.0",
    "node-forge": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "recharts": "^3.8.1",
    "xml-crypto": "^6.1.2",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.5.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.4.6",
    "electron-builder": "^26.8.1",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "kill-port": "^2.0.1",
    "postcss": "^8.5.12",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.2.4",
    "vite": "^4.4.5",
    "wait-on": "^7.2.0"
  }
}
