{
  "name": "smart-tailor-pos",
  "private": true,
  "version": "1.9.0",
  "description": "البصمة الذكية - نظام إدارة نقاط البيع المتطور",
  "productName": "خياط البصمة الذكية",
  "main": "electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EbrahimAgaber/smart-touch-pos.git"
  },
  "scripts": {
    "start": "npm run electron:dev",
    "dev": "vite --host 0.0.0.0 --port 3000",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on tcp:127.0.0.1:3000 && electron . --dev\"",
    "build": "vite build",
    "clean": "rimraf dist dist-electron node_modules/.vite",
    "dist": "npm run build && electron-builder",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "lint": "eslint src --ext js,jsx",
    "preview": "vite preview --host 0.0.0.0 --port 3000"
  },
  "build": {
    "appId": "com.albasma.smarttouch",
    "productName": "البصمة الذكية",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron/vendor/openssl/${arch}",
        "to": "openssl",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "public/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "artifactName": "Setup.${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "البصمة الذكية",
      "createDesktopShortcut": "always"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "EbrahimAgaber",
        "repo": "smart-touch-pos"
      }
    ]
  },
  "author": "AL-Basma (ea.gaber10@gmail.com)",
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.9",
    "@xmldom/xmldom": "^0.8.13",
    "axios": "^1.15.2",
    "better-sqlite3": "^9.6.0",
    "bwip-js": "^4.11.1",
    "cors": "^2.8.6",
    "electron-updater": "^6.8.3",
    "elliptic": "^6.6.1",
    "express": "^5.2.1",
    "fuse.js": "^7.3.0",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "jsbarcode": "^3.12.3",
    "localtunnel": "^2.0.2",
    "lucide-react": "^0.383.0",
    "node-forge": "^1.4.0",
    "node-nlp": "^5.0.0-alpha.5",
    "pdf-parse": "^1.1.1",
    "pino": "^8.21.0",
    "playwright": "^1.62.1",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^6.22.3",
    "recharts": "^3.8.1",
    "sql.js": "^1.14.1",
    "xml-crypto": "^6.1.2",
    "zatca-xml-js": "^0.1.9",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.5.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^22.3.27",
    "electron-builder": "^26.8.1",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "kill-port": "^2.0.1",
    "postcss": "^8.5.12",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.2.4",
    "vite": "^4.4.5",
    "wait-on": "^7.2.0"
  },
  "directories": {
    "test": "tests"
  },
  "keywords": [],
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/EbrahimAgaber/smart-touch-pos/issues"
  },
  "homepage": "https://github.com/EbrahimAgaber/smart-touch-pos#readme",
  "overrides": {
    "lru-cache": "7.14.1"
  }
}
